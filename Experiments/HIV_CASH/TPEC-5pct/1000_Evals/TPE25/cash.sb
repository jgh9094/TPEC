#!/bin/bash -l
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --time=10:00:00
#SBATCH --mem=200G
#SBATCH --job-name=1000_t25_cash
#SBATCH -p defq,moore,preemptable
#SBATCH --array=1-21

source ~/anaconda3/etc/profile.d/conda.sh
conda activate tpe-ea

# standard parameters used for all experiments
TRAIN_P=0.70
GENS=39
POP_SIZE=25
CORES=$SLURM_CPUS_PER_TASK
MUT_PROB=0.25
MUT_VAR=0.25
CROSSOVER_PROB=0.5
COMPONENT_MUT_PROB=0.1
TPE_PROB=0.25
TOURNAMENT_SIZE=2
NUM_OFFSPRING=20
GAMMA=0.3
DATA_DIRECTORY=/home/hernandezj45/Repos/TPEC/Data/HIV/ecoxai_dataset_5pct_no_PHI.csv
# variables that are set by the SLURM job array
# Each array task is one seed of the single target (21 jobs total)
TASK_ID=HIV_DETECTABLE

# SLURM_ARRAY_TASK_ID runs 1-21, one seed per array task (seeds 0-20)
SEED=$(( SLURM_ARRAY_TASK_ID - 1 ))
# Output directory for this specific task and seed
OUTPUT_DIRECTORY=/home/hernandezj45/Repos/TPEC/Results_HIV_5pct/CASH/TPEC/1000_Evals/TPE25/Task_${TASK_ID}/Seed_${SEED}/

python /home/hernandezj45/Repos/TPEC/Experiments/HIV_CASH/TPEC-5pct/runner.py \
    --seed $SEED \
    --y_label $TASK_ID \
    --data_path $DATA_DIRECTORY \
    --train_p $TRAIN_P \
    --output_directory $OUTPUT_DIRECTORY \
    --gens $GENS \
    --pop_size $POP_SIZE \
    --cores $CORES \
    --mut_prob $MUT_PROB \
    --mut_var $MUT_VAR \
    --crossover_prob $CROSSOVER_PROB \
    --component_mut_prob $COMPONENT_MUT_PROB \
    --tpe_prob $TPE_PROB \
    --tournament_size $TOURNAMENT_SIZE \
    --num_offspring $NUM_OFFSPRING \
    --gamma $GAMMA
