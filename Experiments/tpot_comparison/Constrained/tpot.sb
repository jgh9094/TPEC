#!/bin/bash -l
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --time=4-00:00:00
#SBATCH --mem=200G
#SBATCH --job-name=tpot_constrained
#SBATCH -p defq,moore
#SBATCH --array=1-63
#SBATCH --output=/home/sainia3/TPEC/Experiments/tpot_comparison/Constrained/logs/tpot_%A_%a.out

set -euo pipefail

source ~/anaconda3/etc/profile.d/conda.sh
conda activate tpotenv

TRAIN_P=0.70
POP_SIZE=25
GENERATIONS=19
N_EVALUATIONS=500
N_FOLDS=5
MAX_EVAL_TIME_MINS=5
CORES=$SLURM_CPUS_PER_TASK
SEARCH_SPACE=constrained
DATA_PATH=/home/sainia3/TPEC/Data-Tools/spinal_surgery
RUNNER=/home/sainia3/TPEC/Experiments/tpot_comparison/tpot_wrapper.py
RESULTS_ROOT=/home/sainia3/TPEC/Results_TPOT_SpinalSurgery_CustomCVObjective
TASK_IDS=(LOS_extended discharge_Home HOSP_READM_90)

TASK_INDEX=$(( (SLURM_ARRAY_TASK_ID - 1) / 21 ))
SEED=$(( (SLURM_ARRAY_TASK_ID - 1) % 21 + 1 ))
TASK_ID=${TASK_IDS[$TASK_INDEX]}
OUTPUT_DIRECTORY=${RESULTS_ROOT}/Pop${POP_SIZE}/Constrained/Task_${TASK_ID}/Seed_${SEED}/

python -c 'import tpot; print("TPOT version:", tpot.__version__)'

python "$RUNNER" \
    --seed "$SEED" \
    --task so \
    --y_label "$TASK_ID" \
    --data_path "$DATA_PATH" \
    --train_p "$TRAIN_P" \
    --output_directory "$OUTPUT_DIRECTORY" \
    --search_space "$SEARCH_SPACE" \
    --classification true \
    --cores "$CORES" \
    --pop_size "$POP_SIZE" \
    --generations "$GENERATIONS" \
    --n_evaluations "$N_EVALUATIONS" \
    --n_folds "$N_FOLDS" \
    --max_eval_time_mins "$MAX_EVAL_TIME_MINS"
